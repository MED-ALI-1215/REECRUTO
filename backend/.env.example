# ── Copy to .env and fill in real values ─────────────────────────────────────
# NEVER commit .env to git.

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Databases ─────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///./reecruto.db

# Docker (PostgreSQL) — docker-compose overrides this automatically:
# DATABASE_URL=postgresql+psycopg2://reecruto:reecruto@postgres:5432/reecruto

# ChromaDB — local file mode (dev):
CHROMA_USE_SERVER=false
CHROMA_DB_PATH=./chroma_db

# ChromaDB — Docker server mode (set automatically by docker-compose):
# CHROMA_USE_SERVER=true
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# ── Matching ──────────────────────────────────────────────────────────────────
# ChromaDB pre-selects the TOP_K CVs closest to a job once there are at least
# PREFILTER_MIN_CVS CVs; below that, every CV is scored.
MATCH_RETRIEVE_TOP_K=100
MATCH_PREFILTER_MIN_CVS=500
# Semantic skill matching ("Torch" ~ "PyTorch")
SEMANTIC_SKILLS_ENABLED=true
SKILL_SIMILARITY_THRESHOLD=0.80
SEMANTIC_MATCH_FACTOR=0.8

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000/interview
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Recruiter login ───────────────────────────────────────────────────────────
RECRUITER_USERNAME=admin
RECRUITER_PASSWORD=change-me

# ── Interviews ────────────────────────────────────────────────────────────────
INTERVIEW_QUESTION_COUNT=5
MAX_ANSWER_CHARS=4000

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
