# ── Copy to .env and fill in real values ─────────────────────────────────────
# NEVER commit .env to git.

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Databases ─────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///./reecruto.db

# Docker (PostgreSQL) — docker-compose overrides this automatically:
# DATABASE_URL=postgresql+psycopg2://reecruto:reecruto@postgres:5432/reecruto

# ChromaDB — local file mode (dev):
CHROMA_USE_SERVER=false
CHROMA_DB_PATH=./chroma_db

# ChromaDB — Docker server mode (set automatically by docker-compose):
# CHROMA_USE_SERVER=true
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8503
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
